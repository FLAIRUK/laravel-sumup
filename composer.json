{
    "name": "flairuk/laravel-sumup",
    "description": "SumUp payments for Laravel: online checkouts, the Payment Widget, refunds, customers, Cloud API card readers, OAuth and verified webhooks, built on SumUp's official PHP SDK.",
    "keywords": ["laravel", "sumup", "payments", "checkout", "card-reader", "webhooks", "oauth"],
    "homepage": "https://github.com/FLAIRUK/laravel-sumup",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Phil Graham",
            "homepage": "https://github.com/ijeffro",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "sumup/sumup-php": "^0.1.6"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "FLAIRUK\\SumUp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FLAIRUK\\SumUp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FLAIRUK\\SumUp\\SumUpServiceProvider"
            ],
            "aliases": {
                "SumUp": "FLAIRUK\\SumUp\\Facades\\SumUp"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
